<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OnePointUI.Avalonia.Classes">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>
    
    <Style Selector="local|ParallaxImage3D">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="ScaleValue" Duration="0:0:0.3" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Add Styles Here -->
    <StyleInclude Source="BasicControls/Window.axaml" />
    <StyleInclude Source="BasicControls/Button.axaml" />
    <StyleInclude Source="BasicControls/TabControl.axaml" />
    <StyleInclude Source="BasicControls/TextBox.axaml" />
    <StyleInclude Source="BasicControls/CheckBox.axaml" />
    <StyleInclude Source="BasicControls/ComboBox.axaml" />
    <StyleInclude Source="BasicControls/Slider.axaml" />
    <StyleInclude Source="BasicControls/ToggleSwitch.axaml" />
    <StyleInclude Source="BasicControls/ToggleButton.axaml" />
    <StyleInclude Source="BasicControls/TextBlock.axaml" />
    <StyleInclude Source="BasicControls/Expander.axaml" />
    <StyleInclude Source="BasicControls/ScrollBar.axaml" />
    <StyleInclude Source="BasicControls/ScrollViewer.axaml" />
    <StyleInclude Source="BasicControls/ComboBoxItem.axaml" />
    <StyleInclude Source="BasicControls/ComboBox.axaml" />
    <StyleInclude Source="BasicControls/PopupRoot.axaml" />
    <StyleInclude Source="BasicControls/Flyout.axaml" />
    <StyleInclude Source="BasicControls/ListBox.axaml" />
    <StyleInclude Source="BasicControls/ProgressBar.axaml" />
    <StyleInclude Source="BasicControls/HyperLink.axaml" />

    <!-- Newly added Avalonia native controls -->
    <StyleInclude Source="BasicControls/RadioButton.axaml" />
    <StyleInclude Source="BasicControls/RepeatButton.axaml" />
    <StyleInclude Source="BasicControls/ToolTip.axaml" />
    <StyleInclude Source="BasicControls/PathIcon.axaml" />
