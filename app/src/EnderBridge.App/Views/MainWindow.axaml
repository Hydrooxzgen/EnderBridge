<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:EnderBridge.App.Views"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="EnderBridge.App.Views.MainWindow"
        Title="EnderBridge - 跨平台客户端"
        Width="1140" Height="680"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <views:MainView />
</Window>
